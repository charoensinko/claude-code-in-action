# Copy this file to `.env` and fill in ONE of the providers below.
# If neither key is set, the app uses a mock provider that streams canned components.

# --- Option A: Anthropic (takes priority when both are set) ---
ANTHROPIC_API_KEY=your-api-key-here

# --- Option B: OpenRouter (OpenAI-compatible) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-api-key-here
# Optional: override the default OpenRouter model (default: anthropic/claude-sonnet-4.6).
# Any tool-calling-capable model works, e.g. openai/gpt-4o-mini, google/gemini-2.0-flash-001
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
