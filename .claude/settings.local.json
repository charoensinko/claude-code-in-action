{
  "permissions": {
    "allow": [
      "Bash(npx vitest *)",
      "Bash(Select-Object -Last 20)",
      "PowerShell(npx vitest run 2>&1 | Select-Object -Last 25)",
      "PowerShell(git status *)",
      "PowerShell(git *)",
      "Bash(npm audit *)",
      "Bash(Wait-Job -Id * -ErrorAction SilentlyContinue)",
      "Bash(Out-Null)",
      "Bash(Write-Host \"checking\")",
      "PowerShell(npx vitest run src/hooks/__tests__/use-auth.test.ts)",
      "PowerShell(npm test *)",
      "PowerShell(node node_modules/vitest/vitest.mjs run src/hooks/__tests__/use-auth.test.ts)",
      "Bash(npm run *)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(printenv ANTHROPIC_API_KEY)",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_take_screenshot",
      "Bash(npm install *)",
      "Bash(node -e \"console.log\\(require\\('@ai-sdk/openai/package.json'\\).version\\)\")",
      "Bash(npx tsc *)",
      "Bash(node -e \"const p=require\\('@ai-sdk/openai/package.json'\\); console.log\\('@ai-sdk/openai', p.version\\)\")",
      "Bash(node -e \"const d=require\\('./package.json'\\).dependencies; console.log\\('in package.json deps:', d['@ai-sdk/openai']\\)\")",
      "Bash(awk -F= '{ if \\($2==\"your-api-key-here\" || $2==\"\"\\) print $1\"=placeholder/empty\"; else print $1\"=real\\(\"length\\($2\\)\" chars\\)\" }')",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_evaluate",
      "Bash(git ls-remote *)",
      "Bash(gh auth *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000)",
      "mcp__playwright__browser_console_messages",
      "Bash(node hooks/read_hook.js)",
      "Bash(echo \"exit=$?\")",
      "Bash(node -e \"console.log\\('CLAUDE_PROJECT_DIR=', process.env.CLAUDE_PROJECT_DIR\\); console.log\\('PWD=', process.env.PWD\\)\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/read_hook.js\""
          }
        ]
      }
    ]
  }
}
